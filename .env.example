# Copy to .env. Never commit real values.
# Provider keys are read only by the separate MCP tool server, never by the
# harness runtime. Only the providers you actually run need a value.
SERPER_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
PARALLEL_API_KEY=
TINYFISH_API_KEY=
KEENABLE_API_KEY=

# Model and judge credential, owned by the evaluation process.
PRIME_API_KEY=
